{
  "name": "oripo",
  "description": "A multilingual 3D origami studio powered by a reversible TypeScript folding engine.",
  "homepage": "https://oripo.byabolfazl.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abolfazlbzgh/oripo.git"
  },
  "bugs": {
    "url": "https://github.com/abolfazlbzgh/oripo/issues"
  },
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "models": "node scripts/models.mjs",
    "predev": "npm run models -- check",
    "prebuild": "npm run models -- check",
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "node scripts/preview.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:smoke": "playwright test --test-list tests/browser/smoke.txt",
    "test:browser": "playwright test",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@react-router/dev": "8.5.2",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "ajv": "6.15.0",
    "daisyui": "5.8.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "sirv": "^3.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
